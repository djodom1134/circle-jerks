# Shared public deployment settings
PUBLIC_BASE_URL=https://noise.example.com
APP_SECRET=replace-with-a-long-random-string
CADDY_DOMAIN=noise.example.com
# The Lost Landing ledger sidecar's subdomain — separate Caddy site block,
# reverse-proxying to the ledger-api/web-ledger services. See DEPLOY-LEDGER.md.
CADDY_LEDGER_DOMAIN=ledger.noise.example.com
# Optional space-separated list of additional hostnames the ledger block also
# answers for — each a byte-identical mirror of CADDY_LEDGER_DOMAIN, one per
# airport subdomain. Leave empty to disable. See DEPLOY-LEDGER-MIRROR.md.
# e.g. CADDY_LEDGER_MIRROR_DOMAIN="lmco.airfieldeconomics.org klmo.airfieldeconomics.org"
CADDY_LEDGER_MIRROR_DOMAIN=
CLOUDFLARE_API_TOKEN=
UPTIME_ALERT_EMAILS=
UPTIME_REGIONS=us_east,us_west,eu_west

# Third-party providers
GROQ_API_KEY=
# OpenSky OAuth client_credentials. Either set OPENSKY=client_id:client_secret or the
# split variables below. Used for live state fallback and origin enrichment.
OPENSKY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# FlightAware AeroAPI key (https://flightaware.com/aeroapi). Used for fast,
# high-quality origin enrichment on COMMERCIAL callsigns (e.g. UAL640, SWA3533).
# N-numbers / GA aircraft are skipped automatically to preserve the $5/mo
# Personal-tier credit (~500 lookups). Empty = disabled.
FLIGHTAWARE=

# Optional paid ADS-B feed: ADSBExchange via RapidAPI. Sign up at
# https://rapidapi.com/adsbx/api/adsbexchange-com1 and paste the key here. When set,
# adsbx becomes the primary live source and the other free feeds fall back behind it.
ADSBX_RAPIDAPI_KEY=

# Optional self-hosted readsb / tar1090 feeder URL (e.g. a local PiAware/ADSBExchange
# feeder). When set, runs second in priority after adsbx with zero rate limits.
SELF_HOSTED_FEEDER_BASE_URL=

# Backend settings
CIRCLEJERK_ENVIRONMENT=production
CIRCLEJERK_PUBLIC_BASE_URL=https://noise.example.com
# Signs the admin session cookie and the OAuth state cookie. When
# CIRCLEJERK_ENVIRONMENT=production, the app now REFUSES TO START if this is
# left at its insecure development default — see "Google SSO deploy order"
# in DEPLOY.md for why. Generate a real value with e.g. `openssl rand -hex 32`.
CIRCLEJERK_APP_SECRET=replace-with-a-long-random-string
CIRCLEJERK_DATABASE_PATH=/app/data/circlejerk.sqlite3
CIRCLEJERK_REDIS_URL=redis://valkey:6379/0
CIRCLEJERK_TIMEZONE=America/Denver
CIRCLEJERK_DEFAULT_AIRPORT_ICAO=KBJC
# Priority is filtered to sources whose keys/URLs are configured. Unset paid sources
# are skipped silently so this default works in dev with no extra env vars.
CIRCLEJERK_LIVE_SOURCE_PRIORITY=adsbx,self_hosted,adsb_lol,adsb_fi,airplanes_live,opensky
CIRCLEJERK_LIVE_POLL_INTERVAL_SECONDS=10
CIRCLEJERK_LIVE_SOURCE_MAX_STALENESS_SECONDS=90
CIRCLEJERK_BBOX_MERGE_DISTANCE_NM=5
CIRCLEJERK_OPENSKY_HISTORICAL_ENABLED=true

# Base URL of the ledger sidecar, used by the public /v1/ledger/* proxy.
# Defaults to the docker-compose service name; override only if you run
# ledger-api elsewhere. Leave unset for local dev — /v1/ledger/* then
# returns 503 until the sidecar is running.
CIRCLEJERK_LEDGER_API_BASE_URL=http://ledger-api:8100

# Admin access -------------------------------------------------------------
# Emails that are always super-admin, forced on every login. Survives a
# database wipe and cannot be demoted through the UI. Comma separated.
ADMIN_SUPERUSERS=you@example.com

# Google OAuth client (type: Web application) from Google Cloud Console.
# The redirect URI is stated explicitly, never inferred from request headers
# (deriving it from X-Forwarded-Prefix is the pattern that caused a prior
# production failure in this codebase — see DEPLOY.md).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://circlejerks.live/api/admin/auth/google/callback
